# Public site links. VITE_* values are exposed in the built frontend.
# GitHub falls back to https://github.com/GeanToroDevFS when this variable is empty.
# LinkedIn stays visible and opens only when this variable has an http(s) URL.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# EmailJS. The contact form stays usable as a layout, and shows an error
# on submit until the three identifiers below are set.
# VITE_MY_EMAIL is optional. If empty, the public address in src/constants is used.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_MY_EMAIL=
